# Optional: enables AI "In short:" figure explanations (Meta Muse Ember via OpenRouter).
OPENROUTER_API_KEY=

# Optional: set to "false" to disable explanations even when a key is present.
ENABLE_EXPLANATIONS=

# Optional: shared cache via Upstash Redis (Vercel Marketplace). When unset,
# the app falls back to an in-memory cache. UPSTASH_REDIS_REST_URL/TOKEN work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: bearer token that protects GET /api/stats (usage counters).
STATS_TOKEN=
