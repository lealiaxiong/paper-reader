# Optional: enables AI "In short:" figure explanations (Meta Muse Ember via OpenRouter).
OPENROUTER_API_KEY=

# Explanations are opt-in: set to "true" (together with OPENROUTER_API_KEY)
# to enable them. Any other value keeps the app fully deterministic.
ENABLE_EXPLANATIONS=

# Optional: shared cache via Upstash Redis. On Vercel the Marketplace
# integration injects KV_REST_API_URL/TOKEN automatically. These KV_* values
# are ignored outside Vercel, so local dev never touches the production
# database (it uses the in-memory cache instead).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: to use Redis in local dev, point these at a separate (non-prod)
# Upstash database. UPSTASH_* takes precedence over KV_* everywhere.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: bearer token that protects GET /api/stats (usage counters).
STATS_TOKEN=

# BYOM publishing. Comma-separated bearer tokens; each token is a publisher
# identity used for ownership and per-publisher dedupe. Publishing is disabled
# when this is empty.
PUBLISH_TOKENS=

# Optional: admin token for DELETE /api/handoff/<slug> takedowns.
ADMIN_TOKEN=

# Optional: ephemeral handoff lifetime in seconds (default 21600; clamped
# between 3600 and 86400).
HANDOFF_TTL_SECONDS=
