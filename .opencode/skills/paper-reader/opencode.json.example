{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "paper-reader": {
      "type": "local",
      "command": ["node", "/absolute/path/to/paper-reader/mcp/dist/server.js"],
      "environment": {
        "PAPER_READER_URL": "https://paper-reader-omega.vercel.app",
        "PAPER_READER_TOKEN": "{env:PAPER_READER_TOKEN}"
      }
    }
  }
}
